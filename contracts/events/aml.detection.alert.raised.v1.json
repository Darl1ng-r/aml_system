{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.aml.internal/events/aml.detection.alert.raised.v1.json",
  "title": "AmlAlertRaisedEvent",
  "description": "CloudEvents v1.0 specification for an AML detection alert generated by rule or ML evaluation engines.",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "data"],
  "properties": {
    "specversion": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "format": "uri" },
    "type": { "type": "string", "const": "aml.detection.alert.raised.v1" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "type": "string", "const": "application/json" },
    "traceparent": { "type": "string" },
    "tenantid": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["alert_id", "tenant_id", "transaction_id", "rule_type", "severity", "score"],
      "properties": {
        "alert_id": { "type": "string" },
        "tenant_id": { "type": "string" },
        "transaction_id": { "type": "string" },
        "rule_type": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "reason": { "type": "string" },
        "evidence": { "type": "object" },
        "investigation_status": { "type": "string", "default": "PENDING_TRIAGE" }
      },
      "additionalProperties": true
    }
  }
}
