# ════════════════════════════════════════════════════════════════════════════
# Production Environment Configuration Template (.env.production.example)
# ════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.production when provisioning live production instances.
# All passwords and secrets MUST be injected via your secret orchestrator
# (HashiCorp Vault, AWS Secrets Manager, or Kubernetes SealedSecrets).
# ════════════════════════════════════════════════════════════════════════════

# ── Core Runtime & Compliance Environment ───────────────────────────────────
ENVIRONMENT=production
ALLOW_OFFLINE_DEV=false

# ── PostgreSQL Database Settings ────────────────────────────────────────────
POSTGRES_HOST=aml-postgres
POSTGRES_PORT=5432
POSTGRES_REPLICA_HOST=aml-postgres-replica
POSTGRES_REPLICA_PORT=5432
POSTGRES_DB=aml_db
POSTGRES_USER=aml_app
# Generate with: openssl rand -hex 24
AML_APP_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_FOR_MIGRATIONS
RUN_MIGRATIONS_ON_STARTUP=false

# ── Neo4j Graph Database Settings ───────────────────────────────────────────
NEO4J_URI=bolt://aml-neo4j:7687
NEO4J_USER=neo4j
# Generate with: openssl rand -hex 24
NEO4J_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD

# ── Redis Cache & Rate Limiting Settings ────────────────────────────────────
REDIS_HOST=aml-redis
REDIS_PORT=6379
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD

# ── Redpanda / Kafka Event Stream ───────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=aml-redpanda:9092
TRANSACTIONS_TOPIC=aml.transactions.scored

# ── Elasticsearch Cluster ───────────────────────────────────────────────────
ELASTICSEARCH_HOST=http://aml-elasticsearch:9200
SANCTIONS_INDEX=sanctions_list
PEP_INDEX=pep_list
ELASTIC_USER=elastic
# Generate with: openssl rand -hex 24
ELASTIC_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PASSWORD

# ── JWT Authenticator & Cryptographic Keys ──────────────────────────────────
# Algorithm should be RS256 or ES256 (asymmetric).
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Mounted as file from Vault / Secret: /var/run/secrets/tls/jwt_private.pem
JWT_SECRET_KEY=

# ── Metrics Gatekeeper Token ────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
METRICS_SECRET=REPLACE_WITH_PROD_METRICS_BEARER_TOKEN

# ── Supabase Auth Integration ───────────────────────────────────────────────
SUPABASE_URL=https://xzhsdffpnrlpcitiectz.supabase.co
SUPABASE_KEY=REPLACE_WITH_PRODUCTION_SUPABASE_SERVICE_ROLE_KEY

# ── CORS Whitelist (Strict Origin Domain) ───────────────────────────────────
# Must match your reverse-proxy / CDN domain. Localhost is strictly forbidden in production!
ALLOWED_ORIGINS=https://aml.yourdomain.com

# ── Observability & APM ─────────────────────────────────────────────────────
OTEL_SERVICE_NAME=aml-platform-prod
OTEL_EXPORTER_ENDPOINT=http://aml-otel-collector:4317
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Mutual TLS (mTLS) Mesh ──────────────────────────────────────────────────
ENABLE_TLS=true
STRICT_MTLS=true
TLS_CA_CERT=/var/run/secrets/tls/ca.crt
TLS_CLIENT_CERT=/var/run/secrets/tls/tls.crt
TLS_CLIENT_KEY=/var/run/secrets/tls/tls.key
