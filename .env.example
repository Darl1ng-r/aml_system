# PostgreSQL Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aml_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword

# Neo4j Graph Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=passwordpassword

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379

# Redpanda/Kafka Queue Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTIONS_TOPIC=aml.transactions.scored

# Elasticsearch Settings
ELASTICSEARCH_HOST=http://localhost:9200
SANCTIONS_INDEX=sanctions_list
# Required when xpack.security.enabled=true (set in docker-compose / K8s)
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme_in_production

# JWT Authenticator Settings
JWT_SECRET_KEY=replace_with_secure_random_256_bit_key
JWT_ALGORITHM=HS256
# Short-lived access token (30 min). Clients use the refresh token to silently renew.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived refresh token (7 days). Rotated on each /auth/refresh call.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Auth Integration
SUPABASE_URL=https://xzhsdffpnrlpcitiectz.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# CORS Configuration
# Frontend origin only — never include the API server URL here.
ALLOWED_ORIGINS=http://localhost:3000
