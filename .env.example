# Deployment Environment ("development" | "staging" | "production")
ENVIRONMENT=development

# PostgreSQL Database Settings
# NOTE: In production these are overridden by Vault (secret/data/aml/postgres).
#       These env vars serve as local dev fallbacks only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aml_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
AML_APP_PASSWORD=
RUN_MIGRATIONS_ON_STARTUP=false

# Neo4j Graph Database Settings
# NOTE: In production overridden by Vault (secret/data/aml/neo4j).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=passwordpassword

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redpanda/Kafka Queue Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TRANSACTIONS_TOPIC=aml.transactions.scored

# Elasticsearch Settings
# NOTE: In production password is overridden by Vault (secret/data/aml/elasticsearch).
ELASTICSEARCH_HOST=http://localhost:9200
SANCTIONS_INDEX=sanctions_list
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme_in_production

# JWT Authenticator Settings (RS256 Asymmetric Signing)
# In production, provide 2048-bit RSA Private Key PEM directly or via Vault/Secret volume.
# Generate: openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY_PEM=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Auth Integration
# NOTE: In production overridden by Vault (secret/data/aml/supabase).
SUPABASE_URL=https://xzhsdffpnrlpcitiectz.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Telemetry Protection & CORS Configuration
METRICS_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# HashiCorp Vault — Secrets Management
# =============================================================================
#
# LOCAL DEV (no Vault install required):
#   Leave VAULT_ADDR empty. The system falls back to the env vars above.
#
# LOCAL DEV WITH VAULT (vault server -dev):
#   VAULT_ADDR=http://127.0.0.1:8200
#   VAULT_DEV_TOKEN=root            # root token printed by vault -dev
#   (Do NOT set VAULT_ROLE_ID / VAULT_SECRET_ID when using VAULT_DEV_TOKEN)
#
# PRODUCTION (AppRole):
#   Run scripts/vault_bootstrap.sh once to create the AppRole and get credentials.
#   Then set:
#   VAULT_ADDR=http://vault:8200
#   VAULT_ROLE_ID=<role_id from bootstrap script>
#   VAULT_SECRET_ID=<secret_id from bootstrap script>
#   (Do NOT set VAULT_DEV_TOKEN in production)
#
# Optional overrides:
#   VAULT_MOUNT=secret                     # KV-v2 mount path (default: secret)
#   VAULT_LEASE_RENEWAL_SECONDS=3600       # Background renewal interval
#
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_DEV_TOKEN=
VAULT_MOUNT=secret
VAULT_LEASE_RENEWAL_SECONDS=3600
